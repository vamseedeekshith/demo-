# Demo passwords are unsafe for a public deployment. Set these BEFORE first startup.
JS_ADMIN_PASSWORD=change-this-admin-password
JS_CITIZEN_PASSWORD=change-this-citizen-password
JS_POLICE_PASSWORD=change-this-police-password
JS_HOSPITAL_PASSWORD=change-this-hospital-password
# Set to 1 only when serving over HTTPS:
JS_COOKIE_SECURE=0
